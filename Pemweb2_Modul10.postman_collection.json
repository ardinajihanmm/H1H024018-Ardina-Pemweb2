                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Fiber JWT",
      "item": [
        {
          "name": "POST login Fiber",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"akun.fiber@example.com\",\n  \"kata_sandi\": \"GANTI_PASSWORD_UJI\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) { const hasil = pm.response.json(); if (hasil?.data?.token) pm.collectionVariables.set(\"token\", hasil.data.token); }"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "POST registrasi Fiber",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/registrasi",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "registrasi"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nama\": \"Pengguna Uji\",\n  \"email\": \"akun.baru@example.com\",\n  \"kata_sandi\": \"GANTI_PASSWORD_UJI\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "POST refresh token Fiber",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/segarkan",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "segarkan"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
