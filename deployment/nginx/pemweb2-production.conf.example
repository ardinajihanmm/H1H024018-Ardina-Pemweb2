# CONTOH SAJA: sertifikat /etc/letsencrypt harus tersedia terlebih dahulu.
# Jangan pakai php artisan serve untuk aplikasi publik; gunakan Nginx + PHP-FPM.
server {
    listen 80;
    server_name api.example.org;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name api.example.org;
    ssl_certificate /etc/letsencrypt/live/api.example.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/api.example.org/privkey.pem;

    # /fiber/api/... diproksikan ke Fiber /api/...
    location /fiber/ {
        proxy_pass http://127.0.0.1:3000/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Untuk Laravel, konfigurasikan virtual host sendiri dengan public/ dan PHP-FPM.
    # Jika Laravel punya reverse proxy terpisah lokal, /laravel/ dapat diaktifkan
    # seperti file contoh pemweb2-lab.conf, setelah header dan subpath divalidasi.
}
