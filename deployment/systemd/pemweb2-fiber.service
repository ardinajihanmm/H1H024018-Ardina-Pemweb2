[Unit]
Description=Pemweb2 Fiber REST API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/pemweb2-api
EnvironmentFile=/etc/pemweb2/fiber.env
ExecStart=/var/www/pemweb2-api/bin/api
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
